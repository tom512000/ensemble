# The server loads the root .env. Copy this file to .env for local PostgreSQL.
NODE_ENV=development
PORT=3005
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5175,http://127.0.0.1:5175
DATABASE_URL=postgresql://ensemble:ensemble_dev@localhost:55432/ensemble
LOG_LEVEL=info
# Keep false behind a direct connection. Enable only behind a trusted proxy.
TRUST_PROXY=false
MAX_ROOMS=500
# Vite loads this root file too. Leave URLs empty to use its local proxy.
VITE_API_URL=
VITE_WS_URL=
